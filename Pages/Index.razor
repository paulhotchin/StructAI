@page "/"
@inject HttpClient Http
@inject NavigationManager Nav
@inject WizardEngine Engine
@using StructAI.Components
@using StructAI.Services

@if (Engine.Definition is null || Engine.Model is null) {
    <p>Loading wizard...</p>
} else {
    <h1>@Engine.CurrentStep.Name</h1>
    <p>@Engine.CurrentStep.Description</p>

    @foreach (var field in Engine.CurrentStep.Fields) {
        <FieldRenderer Field="field" />
    }

    <button @onclick="Save">Save</button>
    <button @onclick="Engine.PreviousStep">Back</button>
    <button @onclick="Engine.NextStep">Next</button>
}

@code {
    // private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            await Engine.LoadModelAsync(Http);
            // _loaded = true;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync() {
        await Engine.LoadMetadataAsync(Http);
        await Engine.LoadModelAsync(Http);
    }

    private async Task Save() {
        await Engine.SaveModelAsync();
    }
}
