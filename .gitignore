# Ignore build folders inside StructAI
bin/
obj/
publish/
TestResults/

# VS / Rider
.vs/
.idea/
*.user
*.suo
*.cache
*.tmp
*.db

# Ignore Blazor build output
wwwroot/_framework/
wwwroot/service-worker-assets.js
wwwroot/*.dll
