wwwroot/*.wasm
wwwroot/*.map

*.log

# OS junk
Thumbs.db
.DS_Store

# Track your actual assets
!wwwroot/css/**
!wwwroot/metadata/**
!wwwroot/models/**
!wwwroot/*.html
!wwwroot/*.ico
!wwwroot/manifest*
!wwwroot/service-worker.js
