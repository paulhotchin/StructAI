@using StructAI.Wizard

<div class="field">
    <div class="field-label">
        <label class="field-label-text">
            <InputCheckbox @bind-Value="value" />
            @Field.Label
        </label>

        <FieldHint Field="Field" />
    </div>
</div>

@code {
    [Parameter] public WizardField Field { get; set; } = default!;

    private bool value
    {
        get => Field.GetValue<bool>();
        set => Field.SetValue(value);
    }
}
