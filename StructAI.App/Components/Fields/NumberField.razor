@using StructAI.Wizard
@using StructAI.Services
@using System.Text.Json
@inject WizardEngine Engine

<div class="field">
    <div class="field-label">
        <label class="field-label-text">@Field.Label</label>
        <FieldHint Field="Field" />

        <InputNumber TValue="double"
                     @bind-Value="Value"
                     class="form-control"
                     style="width:90px; flex:0 0 90px;" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public WizardField Field { get; set; } = default!;

    private double Value
    {
        get
        {
            var path = Field.Path ?? Field.Bind;

            if (!string.IsNullOrWhiteSpace(path) &&
                Engine.TryResolvePath<double>(path, out var modelValue))
            {
                return modelValue;
            }

            return ReadFieldValue();
        }
        set
        {
            Field.SetValue(value);

            var path = Field.Path ?? Field.Bind;

            if (!string.IsNullOrWhiteSpace(path) &&
                Engine.TrySetPath(path, value))
            {
                Engine.NotifyModelChanged();
            }
        }
    }

    private double ReadFieldValue()
    {
        var raw = Field.GetValue<object>();

        if (raw is double number)
            return number;

        if (raw is JsonElement json &&
            json.ValueKind == JsonValueKind.Number &&
            json.TryGetDouble(out var value))
        {
            return value;
        }

        return raw is IConvertible convertible
            ? Convert.ToDouble(convertible)
            : 0;
    }
}
