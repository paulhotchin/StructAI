@using StructAI.Wizard
@using System.Text.Json

<div class="field">
    <label>@Field.Label</label>

    <InputNumber TValue="double" @bind-Value="value" class="form-control" />

    @if (!string.IsNullOrWhiteSpace(Field.UI?.Hint))
    {
        <small class="text-muted">@Field.UI.Hint</small>
    }
</div>

@code {
    [Parameter] public WizardField Field { get; set; } = default!;

    private double value
    {
        get => ReadNumericValue();
        set => Field.SetValue(value);
    }

    private double ReadNumericValue()
    {
        object? raw = Field.GetValue<object>();

        if (raw == null)
            return 0;

        if (raw is double d)
            return d;

        if (raw is IConvertible conv)
            return Convert.ToDouble(conv);

        if (raw is JsonElement je)
        {
            if (je.ValueKind == JsonValueKind.Number && je.TryGetDouble(out double jd))
                return jd;

            if (je.ValueKind == JsonValueKind.String && double.TryParse(je.GetString(), out double js))
                return js;

            return 0;
        }

        if (raw is string s && double.TryParse(s, out double parsed))
            return parsed;

        return 0;
    }
}
