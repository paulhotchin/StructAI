@using StructAI.Wizard
@using StructAI.Model
@using System.Text.Json
@using System.Reflection
@inject WizardEngine Engine

<div class="field">
    <label>@Field.Label</label>

    <div class="point-list">
        @for (int i = 0; i < Points.Count; i++)
        {
            var pt = Points[i];
            <div class="point-row">
                <InputNumber TValue="double" @bind-Value="Points[i].X" class="form-control" />
                <InputNumber TValue="double" @bind-Value="Points[i].Y" class="form-control" />

                <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeletePoint(pt)">
                    Delete
                </button>
            </div>
        }
    </div>

    <button type="button" class="btn btn-sm btn-primary" @onclick="AddPoint">
        Add Point
    </button>

    @if (!string.IsNullOrWhiteSpace(Field.UI?.Hint))
    {
        <small class="text-muted">@Field.UI.Hint</small>
    }

    <hr />

    <svg width="400" height="400" style="border:1px solid #ccc;">
        @if (Points.Count > 1)
        {
            <polyline
                points="@SvgPoints"
                fill="none"
                stroke="black"
                stroke-width="2" />

            @foreach (var pt in Points)
            {
                <circle cx="@pt.X" cy="@pt.Y" r="4" fill="red" />
            }
        }
    </svg>

    <div class="mt-2">
        <strong>Perimeter:</strong> @Perimeter.ToString("0.00")
        <br />
        <strong>Area:</strong> @Area.ToString("0.00")
    </div>
</div>

@code {
    [Parameter] public WizardField Field { get; set; } = default!;
    private List<Point> _points = new();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        // 1. field already has a value
        var existing = Field.GetValue<List<Point>>();
        if (existing != null)
        {
            _points = existing;
            return;
        }

        // 2. hydrate from the model using the field path
        if (!string.IsNullOrWhiteSpace(Field.Path))
        {
            var modelValue = ResolvePath(Engine.Model, Field.Path);

            if (modelValue is List<Point> list)
            {
                Field.SetValue(list);
                _points = list;
                return;
            }

            if (modelValue is JsonElement je && je.ValueKind == JsonValueKind.Array)
            {
                _points = je.EnumerateArray()
                    .Select(p => new Point
                    {
                        X = p.TryGetProperty("X", out var xEl) && xEl.TryGetDouble(out var x) ? x : 0,
                        Y = p.TryGetProperty("Y", out var yEl) && yEl.TryGetDouble(out var y) ? y : 0
                    })
                    .ToList();

                Field.SetValue(_points);
                return;
            }
        }

        // 3. first-load default
        _points = new List<Point>();
        Field.SetValue(_points);
    }

    private static object? ResolvePath(object? root, string path)
    {
        if (root == null || string.IsNullOrWhiteSpace(path))
            return null;

        object? current = root;

        foreach (var segment in path.Split('.', StringSplitOptions.RemoveEmptyEntries))
        {
            if (current == null)
                return null;

            if (current is JsonElement je)
            {
                current = JsonSerializer.Deserialize<object>(je.GetRawText());
            }

            var prop = current.GetType().GetProperty(segment, BindingFlags.Public | BindingFlags.Instance);
            if (prop == null)
                return null;

            current = prop.GetValue(current);
        }

        return current;
    }

    private List<Point> Points
    {
        get => _points;
        set
        {
            _points = value ?? new List<Point>();
            Field.SetValue(_points);
        }
    }

    private string SvgPoints =>
        string.Join(" ", Points.Select(p => $"{p.X},{p.Y}"));

    private void AddPoint()
    {
        Points.Add(new Point { X = 0, Y = 0 });
        Field.SetValue(Points);
    }

    private void DeletePoint(Point pt)
    {
        Points.Remove(pt);
        Field.SetValue(Points);
    }

    private double Perimeter => ComputePerimeter(Points);
    private double Area => ComputeArea(Points);

    private double ComputePerimeter(List<Point> pts)
    {
        if (pts.Count < 2) return 0;

        double sum = 0;
        for (int i = 0; i < pts.Count; i++)
        {
            var a = pts[i];
            var b = pts[(i + 1) % pts.Count];
            sum += Math.Sqrt(Math.Pow(b.X - a.X, 2) + Math.Pow(b.Y - a.Y, 2));
        }
        return sum;
    }

    /// <param name="pts">The list of points defining the polygon</param>
    /// <returns>The area of the polygon</returns>
    private double ComputeArea(List<Point> pts)
    {
        if (pts.Count < 3) return 0;

        double sum = 0;
        for (int i = 0; i < pts.Count; i++)
        {
            var a = pts[i];
            var b = pts[(i + 1) % pts.Count];
            sum += (a.X * b.Y) - (a.Y * b.X);
        }
        return Math.Abs(sum) / 2.0;
    }
}
