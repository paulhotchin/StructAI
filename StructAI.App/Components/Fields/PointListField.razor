@using StructAI.Wizard
@using StructAI.Model
@using StructAI.Components.Fields
@using System.Text.Json
@using System.Reflection
@using System.Collections
@using System.Globalization
@using Microsoft.JSInterop
@inject WizardEngine Engine
@inject IJSRuntime JS

@implements IDisposable

<div class="field">
    <div class="field-label">
        <label class="field-label-text">@Field.Label</label>
        <FieldHint Field="Field" />
    </div>

    <div class="point-list">
        @foreach (var pt in Points)
        {
            <div class="point-row">
                <InputNumber TValue="double"
                             @bind-Value="pt.X"
                             @onfocus="SelectAllOnFocus"
                             class="form-control point-input" />

                <InputNumber TValue="double"
                             @bind-Value="pt.Y"
                             @onfocus="SelectAllOnFocus"
                             class="form-control point-input" />

                <button type="button"
                        class="btn btn-sm btn-danger"
                        disabled="@(Points.Count <= 3)"
                        @onclick="() => DeletePoint(pt)">
                    Delete
                </button>
            </div>
        }
    </div>

    <button type="button"
            class="btn btn-sm btn-primary"
            @onclick="AddPoint">
        Add Point
    </button>

    <hr />

    <div class="svg-container">
        <svg class="point-svg"
            viewBox="0 0 400 400"
            preserveAspectRatio="xMidYMid meet">
            @if (Points.Count >= 2)
            {
                <polygon points="@SvgPoints"
                        fill="none"
                        stroke="black"
                        stroke-width="2" />

                @foreach (var point in Points)
                {
                    var position = Scale(point);

                    <circle cx="@position.x"
                            cy="@position.y"
                            r="4"
                            fill="red" />
                }
            }

            <g aria-label="North"
            transform="@($"rotate({RealNorthDegrees.ToString(CultureInfo.InvariantCulture)} 360 55)")">
                <line x1="360" y1="70"
                    x2="360" y2="25"
                    stroke="green"
                    stroke-width="3" />

                <polygon points="360,12 351,30 369,30"
                        fill="green" />

                <text x="360"
                    y="92"
                    text-anchor="middle"
                    fill="green"
                    font-weight="bold">
                    N
                </text>
            </g>
        </svg>
    </div>

    <div class="mt-2">
        <strong>Perimeter:</strong> @Perimeter.ToString("0.00")
        <br />
        <strong>Area:</strong> @Area.ToString("0.00")
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public WizardField Field { get; set; } = default!;

    private List<Point> _points = new();

    private List<Point> Points => _points;

    protected override void OnInitialized()
    {
        Engine.ModelChanged += OnModelChanged;
    }

    protected override void OnParametersSet()
    {
        var path = Field.Path ?? Field.Bind;

        if (!string.IsNullOrWhiteSpace(path) &&
            Engine.TryResolvePath<List<Point>>(path, out var modelPoints) &&
            modelPoints is not null)
        {
            _points = modelPoints;
            return;
        }

        _points = Field.GetValue<List<Point>>() ?? new List<Point>();
        Field.SetValue(_points);
    }

    private void OnModelChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void AddPoint()
    {
        _points.Add(new Point());
        UpdateModel();
    }

    private void DeletePoint(Point point)
    {
        if (_points.Count <= 3)
            return;

        _points.Remove(point);
        UpdateModel();
    }

    private void UpdateModel()
    {
        var path = Field.Path ?? Field.Bind;

        Field.SetValue(_points);

        if (!string.IsNullOrWhiteSpace(path))
            Engine.TrySetPath(path, _points);

        Engine.NotifyModelChanged();
    }

    private async Task SelectAllOnFocus()
    {
        await JS.InvokeVoidAsync("structAI.selectOnCoarsePointer");
    }

    private string SvgPoints =>
        string.Join(" ", Points.Select(point =>
        {
            var position = Scale(point);

            return $"{position.x.ToString(CultureInfo.InvariantCulture)}," +
                   $"{position.y.ToString(CultureInfo.InvariantCulture)}";
        }));

    private (double x, double y) Scale(Point point)
    {
        if (Points.Count == 0)
            return (200, 200);

        const double svgSize = 400;
        const double padding = 20;
        var drawableSize = svgSize - (padding * 2);

        var minX = Points.Min(p => p.X);
        var maxX = Points.Max(p => p.X);
        var minY = Points.Min(p => p.Y);
        var maxY = Points.Max(p => p.Y);

        var width = Math.Max(maxX - minX, 1);
        var height = Math.Max(maxY - minY, 1);
        var scale = Math.Min(drawableSize / width, drawableSize / height);

        var drawnWidth = width * scale;
        var drawnHeight = height * scale;

        var offsetX = (svgSize - drawnWidth) / 2;
        var offsetY = (svgSize - drawnHeight) / 2;

        return (
            offsetX + ((point.X - minX) * scale),
            svgSize - offsetY - ((point.Y - minY) * scale)
        );
    }

    private double RealNorthDegrees =>
        Engine.TryResolvePath<double>(
            "Site.RealNorthDegrees",
            out var degrees)
                ? degrees
                : 0;

    private double Perimeter => ComputePerimeter();
    private double Area => ComputeArea();

    private double ComputePerimeter()
    {
        if (Points.Count < 2)
            return 0;

        return Points
            .Select((point, index) =>
            {
                var next = Points[(index + 1) % Points.Count];
                return Math.Sqrt(
                    Math.Pow(next.X - point.X, 2) +
                    Math.Pow(next.Y - point.Y, 2));
            })
            .Sum();
    }

    private double ComputeArea()
    {
        if (Points.Count < 3)
            return 0;

        var total = 0d;

        for (var i = 0; i < Points.Count; i++)
        {
            var current = Points[i];
            var next = Points[(i + 1) % Points.Count];

            total += current.X * next.Y - next.X * current.Y;
        }

        return Math.Abs(total) / 2;
    }

    public void Dispose()
    {
        Engine.ModelChanged -= OnModelChanged;
    }
}
