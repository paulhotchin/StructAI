@using StructAI.Wizard
@using StructAI.Model
@using System.Text.Json

<div class="field">
    <label>@Field.Label</label>

    <div class="point-list">
        @foreach (var pt in Points)
        {
            <div class="point-row">
                <InputNumber TValue="double" @bind-Value="pt.X" class="form-control" />
                <InputNumber TValue="double" @bind-Value="pt.Y" class="form-control" />

                <button class="btn btn-sm btn-danger" @onclick="() => DeletePoint(pt)">
                    Delete
                </button>
            </div>
        }
    </div>

    <button class="btn btn-sm btn-primary" @onclick="AddPoint">
        Add Point
    </button>

    @if (!string.IsNullOrWhiteSpace(Field.UI?.Hint))
    {
        <small class="text-muted">@Field.UI.Hint</small>
    }

    <hr />

    <svg width="400" height="400" style="border:1px solid #ccc;">
        @if (Points.Count > 1)
        {
            <polyline 
                points="@SvgPoints"
                fill="none"
                stroke="black"
                stroke-width="2" />

            @foreach (var pt in Points)
            {
                <circle cx="@pt.X" cy="@pt.Y" r="4" fill="red" />
            }
        }
    </svg>

    <div class="mt-2">
        <strong>Perimeter:</strong> @Perimeter.ToString("0.00")  
        <br />
        <strong>Area:</strong> @Area.ToString("0.00")
    </div>
</div>

@code {
    [Parameter] public WizardField Field { get; set; } = default!;

    private List<Point> Points
    {
        get
        {
            var pts = Field.GetValue<List<Point>>();
            if (pts == null)
            {
                pts = new List<Point>();
                Field.SetValue(pts);
            }
            return pts;
        }
        set => Field.SetValue(value);
    }

    private Point? ConvertToPoint(object? raw)
    {
        if (raw == null) return null;

        if (raw is Point p)
            return p;

        if (raw is JsonElement je)
        {
            double x = je.TryGetProperty("X", out var xEl) && xEl.TryGetDouble(out var xv) ? xv : 0;
            double y = je.TryGetProperty("Y", out var yEl) && yEl.TryGetDouble(out var yv) ? yv : 0;
            return new Point { X = x, Y = y };
        }

        if (raw is Dictionary<string, object> dict)
        {
            double x = dict.TryGetValue("X", out var xv) ? Convert.ToDouble(xv) : 0;
            double y = dict.TryGetValue("Y", out var yv) ? Convert.ToDouble(yv) : 0;
            return new Point { X = x, Y = y };
        }

        return null;
    }

    private string SvgPoints =>
        string.Join(" ", Points.Select(p => $"{p.X},{p.Y}"));

    private void AddPoint()
    {
        Points.Add(new Point { X = 0, Y = 0 });
        Field.SetValue(Points);
    }

    private void DeletePoint(Point pt)
    {
        Points.Remove(pt);
        Field.SetValue(Points);
    }

    private double Perimeter => ComputePerimeter(Points);
    private double Area => ComputeArea(Points);

    private double ComputePerimeter(List<Point> pts)
    {
        if (pts.Count < 2) return 0;

        double sum = 0;
        for (int i = 0; i < pts.Count; i++)
        {
            var a = pts[i];
            var b = pts[(i + 1) % pts.Count];
            sum += Math.Sqrt(Math.Pow(b.X - a.X, 2) + Math.Pow(b.Y - a.Y, 2));
        }
        return sum;
    }

    /// <param name="pts">The list of points defining the polygon</param>
    /// <returns>The area of the polygon</returns>
    private double ComputeArea(List<Point> pts)
    {
        if (pts.Count < 3) return 0;

        double sum = 0;
        for (int i = 0; i < pts.Count; i++)
        {
            var a = pts[i];
            var b = pts[(i + 1) % pts.Count];
            sum += (a.X * b.Y) - (a.Y * b.X);
        }
        return Math.Abs(sum) / 2.0;
    }
}
