@using StructAI.Wizard

<div class="field">
    <label>@Field.Label</label>

    <InputSelect @bind-Value="value" class="form-control">
        @foreach (var opt in Field.Options ?? Enumerable.Empty<FieldOption>())
        {
            <option value="@opt.Value">@opt.Label</option>
        }
    </InputSelect>

    @if (!string.IsNullOrWhiteSpace(Field.UI?.Hint))
    {
        <small class="text-muted">@Field.UI.Hint</small>
    }
</div>

@code {
    [Parameter] public WizardField Field { get; set; } = default!;

    private string? value
    {
        get => Field.GetValue<string>();
        set => Field.SetValue(value);
    }
}
