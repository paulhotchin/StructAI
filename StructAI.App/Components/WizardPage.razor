@using StructAI.Components
@using StructAI.Model
@using StructAI.Services

@inject HttpClient Http
@inject NavigationManager Nav
@inject WizardEngine Engine

@layout MainLayout
@implements IDisposable

@if (Engine.Definition is null || Engine.Model is null) {
    <p>Loading wizard...</p>
} else {
    <p>@Engine.CurrentStep.Description</p>

        @if (Id == "CeoValueTime" &&
            string.Equals(Engine.CurrentStep.Id, "Results", StringComparison.OrdinalIgnoreCase))
    {
        <CeoValueTimeResults />
    }
    else if (Id == "CicSalesProjection")
    {
        <CicSalesProjectionSteps @key="Id" />
    }
    else
    {
        @foreach (var field in Engine.CurrentStep.Fields) {
            <FieldRenderer Field="field" />
        }
    }

}

@code {
    [Parameter] public string Id { get; set; } = default!;
    [Parameter] public string? InitialProjectName { get; set; }
    [Parameter] public string? InitialProjectRoute { get; set; }

    private string? _loadedId;
    private string? _loadedProjectName;
    private string? _loadedProjectRoute;

    protected override void OnInitialized()
    {
        Engine.ModelChanged += OnModelChanged;
    }

    private void OnModelChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _loadedId &&
            InitialProjectName == _loadedProjectName &&
            InitialProjectRoute == _loadedProjectRoute)
        {
            return;
        }

        _loadedId = Id;
        _loadedProjectName = InitialProjectName;
        _loadedProjectRoute = InitialProjectRoute;

        Engine.BeginLoad();

        var metadataPath = $"AppData/metadata/{Id}Wizard.json";
        var modelPath    = $"AppData/models/{Id}.json";

        await Engine.LoadMetadataAsync(Http, metadataPath);
        await Engine.LoadModelAsync(Http, modelPath, Id);

        if (Id == "StructAiNewProject" && Engine.Model is StructAiNewProject newProject)
        {
            newProject.ProjectName = InitialProjectName ?? newProject.ProjectName;
            newProject.ProjectRoute = InitialProjectRoute ?? newProject.ProjectRoute;
            Engine.NotifyModelChanged();
        }

        Engine.Compute(Id);

        StateHasChanged();
    }

    public void Dispose()
    {
        Engine.ModelChanged -= OnModelChanged;
    }
}
