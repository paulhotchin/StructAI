@using StructAI.Components
@using StructAI.Services

@inject HttpClient Http
@inject NavigationManager Nav
@inject WizardEngine Engine

@layout MainLayout
@implements IDisposable

@if (Engine.Definition is null || Engine.Model is null) {
    <p>Loading wizard...</p>
} else {
    <p>@Engine.CurrentStep.Description</p>

        @if (Id == "CeoValueTime" &&
            string.Equals(Engine.CurrentStep.Id, "Results", StringComparison.OrdinalIgnoreCase))
    {
        <CeoValueTimeResults />
    }
    else
    {
        @foreach (var field in Engine.CurrentStep.Fields) {
            <FieldRenderer Field="field" />
        }
    }

}

@code {
    [Parameter] public string Id { get; set; } = default!;

    protected override void OnInitialized()
    {
        Engine.ModelChanged += OnModelChanged;
    }

    private void OnModelChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        var metadataPath = $"AppData/metadata/{Id}Wizard.json";
        var modelPath    = $"AppData/models/{Id}.json";

        await Engine.LoadMetadataAsync(Http, metadataPath);
        await Engine.LoadModelAsync(Http, modelPath, Id);

        Engine.Compute(Id);

        StateHasChanged();
    }

    public void Dispose()
    {
        Engine.ModelChanged -= OnModelChanged;
    }
}
