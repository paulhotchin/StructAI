@using StructAI.Wizard
@using StructAI.Components.Fields

@{
    var type = Field?.Type?.Trim().ToLower();
}

@switch (type)
{
    case "number":
        <NumberField Field="Field" />
        break;

    case "pointlist":
        <PointListField Field="Field" />
        break;

    case "text":
    case "string":
        <TextField Field="Field" />
        break;

    case "checkbox":
    case "bool":
    case "boolean":
        <CheckboxField Field="Field" />
        break;

    case "select":
    case "dropdown":
        <SelectField Field="Field" />
        break;

    default:
        <p>Unsupported field type: @Field?.Type</p>
        break;
}

@code {
    [Parameter] public WizardField? Field { get; set; }

    protected override void OnParametersSet()
    {
        if (Field is null)
            throw new InvalidOperationException("FieldRenderer: Field parameter is required.");
    }
}
