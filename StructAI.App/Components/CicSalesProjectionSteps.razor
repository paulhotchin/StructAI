@using StructAI.Components
@using StructAI.Model
@using StructAI.Services
@using System.Globalization

@inject WizardEngine Engine

@if (Engine.Model is CicSalesProjection cic)
{
    @if (Engine.CurrentStep.Id == "PriceList")
    {
        <div class="cic-inputs">
            <div class="d-flex justify-content-end mb-3">
                <button type="button" class="btn btn-primary btn-sm" @onclick="AddItem">
                    Add item
                </button>
            </div>

            <table class="table table-bordered cic-table">
                <thead>
                    <tr>
                        <th>Item Name</th>
                        <th>Price</th>
                        <th style="width: 120px;">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in cic.PriceItems)
                    {
                        <tr>
                            <td>
                                <input class="form-control"
                                       value="@item.Name"
                                       @oninput="@(e => UpdateItemName(item, e.Value?.ToString()))" />
                            </td>
                            <td>
                                <InputNumber TValue="double"
                                             class="form-control"
                                             @bind-Value:get="item.Price"
                                             @bind-Value:set="value => UpdateItemPrice(item, value)" />
                            </td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteItem(item)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Engine.CurrentStep.Id == "DataEntry")
    {
        <div class="cic-inputs">
            <table class="table table-bordered cic-table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Per week</th>
                        <th>Per month</th>
                        <th>Per year</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in cic.PriceItems)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>
                                <InputNumber TValue="int"
                                             class="form-control"
                                             @bind-Value:get="item.UnitsPerWeek"
                                             @bind-Value:set="@(value => UpdateUnits(item, value, CicUnitPeriod.Week))" />
                            </td>
                            <td>
                                <InputNumber TValue="int"
                                             class="form-control"
                                             @bind-Value:get="item.UnitsPerMonth"
                                             @bind-Value:set="@(value => UpdateUnits(item, value, CicUnitPeriod.Month))" />
                            </td>
                            <td>
                                <InputNumber TValue="int"
                                             class="form-control"
                                             @bind-Value:get="item.UnitsPerYear"
                                             @bind-Value:set="@(value => UpdateUnits(item, value, CicUnitPeriod.Year))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Engine.CurrentStep.Id == "Results")
    {
        <table class="table table-bordered cic-table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Per week</th>
                    <th>Per month</th>
                    <th>Per year</th>
                    <th>Revenue p.a.</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in cic.PriceItems)
                {
                    <tr>
                        <th>@item.Name</th>
                        <td>@item.UnitsPerWeek</td>
                        <td>@item.UnitsPerMonth</td>
                        <td>@item.UnitsPerYear</td>
                        <td>@FormatCurrency(item.AnnualRevenue)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private enum CicUnitPeriod
    {
        Week,
        Month,
        Year
    }

    private void AddItem()
    {
        if (Engine.Model is not CicSalesProjection cic)
            return;

        cic.PriceItems.Add(new CicPriceItem
        {
            Name = $"Item {cic.PriceItems.Count + 1}",
            Price = 0,
            UnitsPerWeek = 1,
            UnitsPerMonth = 4,
            UnitsPerYear = 48
        });

        cic.SyncLegacyPrices();
        Engine.NotifyModelChanged();
    }

    private void UpdateItemName(CicPriceItem item, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        item.Name = value;
        Engine.NotifyModelChanged();
    }

    private void UpdateItemPrice(CicPriceItem item, double value)
    {
        item.Price = value;
        if (Engine.Model is CicSalesProjection cic)
        {
            cic.SyncLegacyPrices();
        }

        Engine.NotifyModelChanged();
    }

    private void UpdateUnits(CicPriceItem item, int value, CicUnitPeriod period)
    {
        switch (period)
        {
            case CicUnitPeriod.Week:
                item.UnitsPerWeek = value;
                break;
            case CicUnitPeriod.Month:
                item.UnitsPerMonth = value;
                break;
            case CicUnitPeriod.Year:
                item.UnitsPerYear = value;
                break;
        }

        Engine.NotifyModelChanged();
    }

    private void DeleteItem(CicPriceItem item)
    {
        if (Engine.Model is not CicSalesProjection cic)
            return;

        cic.PriceItems.Remove(item);
        cic.SyncLegacyPrices();
        Engine.NotifyModelChanged();
    }

    private static string FormatCurrency(double value) =>
        value.ToString("$#,##0", CultureInfo.InvariantCulture);
}
