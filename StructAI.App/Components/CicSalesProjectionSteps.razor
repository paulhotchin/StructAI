@using StructAI.Components
@using StructAI.Model
@using StructAI.Services
@using System.Globalization

@inject WizardEngine Engine

@if (Engine.Model is CicSalesProjection cic)
{
    @if (Engine.CurrentStep.Id == "PriceList")
    {
        <div class="cic-inputs">
            @* <div class="d-flex justify-content-end mb-3">
                <button type="button" class="btn btn-primary btn-sm" @onclick="AddItem">
                    Add item
                </button>
            </div> *@

            <table class="table table-bordered cic-table cic-entry-table">
                <colgroup>
                    <col class="cic-entry-enabled-column" />
                    <col class="cic-entry-item-column" />
                    <col class="cic-entry-price-column" />
                    <col class="cic-entry-period-column" />
                    <col class="cic-entry-number-column" />
                    <col class="cic-entry-profit-column" />
                    @* <col class="cic-entry-action-column" /> *@
                </colgroup>
                <thead>
                    <tr>
                        <th rowspan="2">
                            <button type="button"
                                    class="cic-enabled-toggle"
                                    @onclick="() => ToggleAllItems(cic)">
                                @AllItemsEnabled(cic)
                            </button>
                        </th>
                        <th rowspan="2">Products & Services</th>
                        <th rowspan="2">Price</th>
                        <th colspan="2">Projected Sales</th>
                        <th rowspan="2">Gross Profit</th>
                        @* <th></th> *@
                    </tr>
                    <tr>
                        <th>Period</th>
                        <th>Number</th>
                        @* <th></th> *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in cic.PriceItems)
                    {
                        <tr>
                            <td>
                                <button type="button"
                                        class="cic-enabled-toggle"
                                        @onclick="() => ToggleItem(item)">
                                    @item.Enabled
                                </button>
                            </td>
                            <td>
                                <input class="form-control"
                                       value="@item.Name"
                                       @oninput="@(e => UpdateItemName(item, e.Value?.ToString()))" />
                            </td>
                            <td>
                                <InputNumber TValue="double"
                                             class="form-control"
                                             @bind-Value:get="item.Price"
                                             @bind-Value:set="value => UpdateItemPrice(item, value)" />
                            </td>
                            <td>
                                <InputSelect TValue="CicPeriod"
                                             class="form-control"
                                             Value="@item.Period"
                                             ValueChanged="@(value => UpdatePeriod(item, value))"
                                             ValueExpression="@(() => item.Period)"
                                             disabled="@item.PeriodLocked">
                                    <option value="@CicPeriod.Week">Week</option>
                                    <option value="@CicPeriod.Month">Month</option>
                                    <option value="@CicPeriod.Year">Year</option>
                                    <option value="@CicPeriod.AprAugNov">Apr Aug Nov</option>
                                    <option value="@CicPeriod.AprJulOct">Apr Jul Oct</option>
                                </InputSelect>
                            </td>
                            <td>
                                <InputNumber TValue="int"
                                             class="form-control"
                                             @bind-Value:get="item.Units"
                                             @bind-Value:set="value => UpdateUnits(item, value)" 
                                             disabled="@item.PeriodLocked"/>
                            </td>
                            <td>
                                <input class="form-control"
                                       value="@FormatPercent(item.ProfitFactor)"
                                       readonly />
                            </td>
                            @* <td>
                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteItem(item)">
                                    Delete
                                </button>
                            </td> *@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Engine.CurrentStep.Id == "Results")
    {
        <table class="table table-bordered cic-table cic-results-table">
            <colgroup>
                <col class="cic-results-item-column" />
                <col class="cic-results-number-column" />
                <col class="cic-results-revenue-column" />
                <col class="cic-results-number-column" />
                <col class="cic-results-revenue-column" />
                <col class="cic-results-number-column" />
                <col class="cic-results-revenue-column" />
            </colgroup>
            <thead>
                <tr>
                    <th rowspan="2">Products & Services</th>
                    <th colspan="2">Week (Year / 48)</th>
                    <th colspan="2">Month (Year / 12)</th>
                    <th colspan="2">Year</th>
                </tr>
                <tr>
                    <th>Number</th>
                    <th>Revenue</th>
                    <th>Number</th>
                    <th>Revenue</th>
                    <th>Number</th>
                    <th>Revenue</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in cic.PriceItems)
                {
                    if (!IsEnabled(item))
                    {
                        continue;
                    }

                    if (item.PeriodLocked)
                    {
                        const double APRAUGNOV_MULTIPLIER = 16d;
                        const double APRJULOCT_MULTIPLIER = 18d;
                        double revenuePerYear = (item.Period == CicPeriod.AprAugNov ? item.Price * APRAUGNOV_MULTIPLIER : item.Price * APRJULOCT_MULTIPLIER) * item.Units;

                        <tr class="cic-results-locked-row">
                            <td>@item.Name</td>
                            <td>&nbsp;</td>
                            <td>@FormatCurrency(revenuePerYear / CicPriceItem.WORK_WEEKS_PER_YEAR)</td>
                            <td>&nbsp;</td>
                            <td>@FormatCurrency(revenuePerYear / CicPriceItem.WORK_MONTHS_PER_YEAR)</td>
                            <td>&nbsp;</td>
                            <td>@FormatCurrency(revenuePerYear)</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@FormatNumeric(item.UnitsPerWeek)</td>
                            <td>@FormatCurrency(item.RevenuePerWeek)</td>
                            <td>@FormatNumeric(item.UnitsPerMonth)</td>
                            <td>@FormatCurrency(item.RevenuePerMonth)</td>
                            <td>@FormatNumeric(item.UnitsPerYear)</td>
                            <td>@FormatCurrency(item.RevenuePerYear)</td>
                        </tr>
                    }
                }
                <tr class="cic-results-total-row">
                    <td></td>
                    <td class="cic-total-label">Total:</td>
                    <td>@FormatCurrency(TotalRevenueFor(cic, CicPeriod.Week))</td>
                    <td class="cic-total-label">Total:</td>
                    <td>@FormatCurrency(TotalRevenueFor(cic, CicPeriod.Month))</td>
                    <td class="cic-total-label">Total:</td>
                    <td>@FormatCurrency(TotalRevenueFor(cic, CicPeriod.Year))</td>
                </tr>
            </tbody>
        </table>
    }
    else if (Engine.CurrentStep.Id == "CashFlow")
    {
        <CicCashflowTable Title="Cash Flow"
                          ProjectionYear="@cic.ProjectionYear"
                          SalesByYear="@BuildYearlyCashflow(cic, false)"
                          ProfitByYear="@BuildYearlyCashflow(cic, true)" />
    }
}

@code {
    private void AddItem()
    {
        if (Engine.Model is not CicSalesProjection cic)
            return;

        cic.PriceItems.Add(new CicPriceItem
        {
            Enabled = "Y",
            Name = $"Item {cic.PriceItems.Count + 1}",
            Price = 0,
            Units = 1,
            Period = CicPeriod.Week,
            UnitsPerWeek = 1,
            UnitsPerMonth = CicPriceItem.WORK_WEEKS_PER_MONTH,
            UnitsPerYear = CicPriceItem.WORK_WEEKS_PER_YEAR
        });

        Engine.NotifyModelChanged();
    }

    private void UpdateItemName(CicPriceItem item, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        item.Name = value;
        Engine.NotifyModelChanged();
    }

    private static string AllItemsEnabled(CicSalesProjection cic) =>
        cic.PriceItems.Count > 0 && cic.PriceItems.All(IsEnabled) ? "Y" : "N";

    private void ToggleAllItems(CicSalesProjection cic)
    {
        var enabled = AllItemsEnabled(cic) == "Y" ? "N" : "Y";

        foreach (var item in cic.PriceItems)
            item.Enabled = enabled;

        Engine.NotifyModelChanged();
    }

    private void ToggleItem(CicPriceItem item)
    {
        item.Enabled = IsEnabled(item) ? "N" : "Y";
        Engine.NotifyModelChanged();
    }

    private static bool IsEnabled(CicPriceItem item) =>
        string.Equals(item.Enabled, "Y", StringComparison.OrdinalIgnoreCase);

    private static double TotalRevenueFor(CicSalesProjection cic, CicPeriod period) =>
        cic.PriceItems
            .Where(IsEnabled)
            .Sum(item => RevenueForResults(item, period));

    private static double RevenueForResults(CicPriceItem item, CicPeriod period)
    {
        if (!item.PeriodLocked)
            return item.RevenueFor(period);

        const double APRAUGNOV_MULTIPLIER = 16d;
        const double APRJULOCT_MULTIPLIER = 18d;
        var annualRevenue = (item.Period == CicPeriod.AprAugNov
            ? item.Price * APRAUGNOV_MULTIPLIER
            : item.Price * APRJULOCT_MULTIPLIER) * item.Units;

        return period switch
        {
            CicPeriod.Week => annualRevenue / CicPriceItem.WORK_WEEKS_PER_YEAR,
            CicPeriod.Month => annualRevenue / CicPriceItem.WORK_MONTHS_PER_YEAR,
            CicPeriod.Year => annualRevenue,
            _ => 0
        };
    }

    private void UpdateItemPrice(CicPriceItem item, double value)
    {
        item.Price = value;
        Engine.NotifyModelChanged();
    }

    private void UpdateUnits(CicPriceItem item, int value)
    {
        item.Units = value;

        switch (item.Period)
        {
            case CicPeriod.Week:
                item.UnitsPerWeek = value;
                item.UnitsPerMonth = value * CicPriceItem.WORK_WEEKS_PER_MONTH;
                item.UnitsPerYear = value * CicPriceItem.WORK_WEEKS_PER_YEAR;
                break;
            case CicPeriod.Month:
                item.UnitsPerMonth = value;
                item.UnitsPerWeek = value / CicPriceItem.WORK_WEEKS_PER_MONTH;
                item.UnitsPerYear = value * CicPriceItem.WORK_MONTHS_PER_YEAR;
                break;
            case CicPeriod.Year:
                item.UnitsPerYear = value;
                item.UnitsPerWeek = value / CicPriceItem.WORK_WEEKS_PER_YEAR;
                item.UnitsPerMonth = value / CicPriceItem.WORK_MONTHS_PER_YEAR;
                break;
            case CicPeriod.AprAugNov:
            case CicPeriod.AprJulOct:
                item.UnitsPerYear = value;
                item.UnitsPerWeek = value / CicPriceItem.WORK_WEEKS_PER_YEAR;
                item.UnitsPerMonth = value / CicPriceItem.WORK_MONTHS_PER_YEAR;
                break;
        }

        Engine.NotifyModelChanged();
    }

    private void UpdatePeriod(CicPriceItem item, CicPeriod value)
    {
        item.Period = value;
        item.Units = (int)Math.Round(value switch
        {
            CicPeriod.Week => item.UnitsPerWeek,
            CicPeriod.Month => item.UnitsPerMonth,
            CicPeriod.Year => item.UnitsPerYear,
            CicPeriod.AprAugNov => item.UnitsPerYear,
            CicPeriod.AprJulOct => item.UnitsPerYear,
            _ => item.Units
        }, MidpointRounding.AwayFromZero);

        Engine.NotifyModelChanged();
    }

    private void DeleteItem(CicPriceItem item)
    {
        if (Engine.Model is not CicSalesProjection cic)
            return;

        cic.PriceItems.Remove(item);
        Engine.NotifyModelChanged();
    }

    private static double[][] BuildYearlyCashflow(CicSalesProjection cic, bool profitOnly)
    {
        var yearlyCashflow = new double[5][];

        for (var yearOffset = 0; yearOffset < yearlyCashflow.Length; yearOffset++)
        {
            yearlyCashflow[yearOffset] = new double[12];

            foreach (var item in cic.PriceItems)
            {
                if (!IsEnabled(item))
                    continue;

                if (item.Period is CicPeriod.AprAugNov or CicPeriod.AprJulOct)
                {
                    var startMonths = item.Period == CicPeriod.AprAugNov
                        ? new[] { 3, 7, 10 }
                        : new[] { 3, 6, 9 };

                    for (var month = 0; month < 12; month++)
                    {
                        var priorYearSales = item.Perennial ? yearOffset * startMonths.Length : 0;
                        var activeSales = priorYearSales + startMonths.Count(startMonth => month >= startMonth);
                        var sales = activeSales * item.Price * item.Units;
                        yearlyCashflow[yearOffset][month] += profitOnly ? sales * item.ProfitFactor : sales;
                    }
                }
                else
                {
                    var monthlyRevenue = item.RevenuePerMonth;
                    for (var month = 0; month < 12; month++)
                        yearlyCashflow[yearOffset][month] += profitOnly
                            ? monthlyRevenue * item.ProfitFactor
                            : monthlyRevenue;
                }
            }
        }

        return yearlyCashflow;
    }

    private static string FormatCurrency(double value) =>
        value.ToString("$#,##0", CultureInfo.InvariantCulture);

    private static string FormatPercent(double value) =>
        value.ToString("0%", CultureInfo.InvariantCulture);

    private static string FormatNumeric(double value)
    {
        if (Math.Abs(value - Math.Round(value)) < 0.0001)
            return value.ToString("0", CultureInfo.InvariantCulture);

        return value.ToString("0.0", CultureInfo.InvariantCulture);
    }
}
