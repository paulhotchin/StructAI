@using System.Globalization

<h3>@Title</h3>

<table class="table table-bordered cic-cashflow-table">
    <thead>
        <tr>
            <th>Year</th>
            @foreach (var month in Months)
            {
                <th>@month</th>
            }
            <th>Totals</th>
        </tr>
    </thead>
    <tbody>
        @for (var yearOffset = 0; yearOffset < 5; yearOffset++)
        {
            <tr class="cic-cashflow-year-row">
                <th colspan="14">@(ProjectionYear + yearOffset)</th>
            </tr>
            <tr>
                <th>Sales</th>
                @foreach (var value in SalesByYear[yearOffset])
                {
                    <td>@FormatCurrency(value)</td>
                }
                <td>@FormatCurrency(SalesByYear[yearOffset].Sum())</td>
            </tr>
            <tr>
                <th>Profit</th>
                @foreach (var value in ProfitByYear[yearOffset])
                {
                    <td>@FormatCurrency(value)</td>
                }
                <td>@FormatCurrency(ProfitByYear[yearOffset].Sum())</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public int ProjectionYear { get; set; }
    [Parameter] public double[][] SalesByYear { get; set; } = Array.Empty<double[]>();
    [Parameter] public double[][] ProfitByYear { get; set; } = Array.Empty<double[]>();

    private static readonly string[] Months =
    {
        "Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
    };

    private static string FormatCurrency(double value) =>
        value.ToString("$#,##0", CultureInfo.InvariantCulture);
}
