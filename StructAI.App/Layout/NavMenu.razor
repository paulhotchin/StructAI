@inject NavigationManager Nav
@inject AppSettingsService AppSettings

<div class="nav-menu">
    <nav class="flex-column">
        @foreach (var project in AppSettings.EnabledProjects)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link"
                         href="@ProjectUrl(project)"
                         Match="@(string.IsNullOrWhiteSpace(project.Url) ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         @onclick="OnToggle">
                    <span class="bi bi-grid-fill-nav-menu"></span> @project.Title
                </NavLink>
            </div>
        }

    </nav>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (AppSettings.Settings is null)
            await AppSettings.LoadAsync();
    }

    private string ProjectUrl(AppProject project) =>
        string.IsNullOrWhiteSpace(project.Url)
            ? Nav.BaseUri.TrimEnd('/')
            : $"{Nav.BaseUri.TrimEnd('/')}/{project.Url.TrimStart('/')}";

    // Called by MainLayout when NavMenu is inside the overlay.
    // Does nothing when NavMenu is inside the desktop sidebar.
    [Parameter] public EventCallback OnToggle { get; set; }
}
