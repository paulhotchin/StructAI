@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject WizardEngine Engine
@inject AppSettingsService AppSettings

<PageTitle>@(AppSettings.Settings?.PageTitle ?? "StructAI")</PageTitle>

<!-- DESKTOP TITLE BAR -->
<div class="desktop-title-bar">
    <span>@(AppSettings.Settings?.Title ?? string.Empty)</span>
    @if ((AppSettings.Settings?.Id ?? string.Empty) != "Innermetrix-CIC")
    {
        <span class="css-version" aria-label="CSS version"></span>
    }
</div>

<!-- DESKTOP SIDEBAR -->
<div class="sidebar-desktop">
    <NavMenu />
</div>

<!-- MAIN PAGE -->
<div class="page">
    <main>

        @if (IsWizardPage)
        {
            <!-- Wizard Top Bar -->
            @if (RequiresSaveButton)
            {
                <TopActionBar Title="@CurrentPageTitle" OnSave="Save" />
            }
            else
            {
                <TopActionBar Title="@CurrentPageTitle" />
            }
                       
            @if (_showSavedMessage)
            {
                <div class="save-status" role="status">Saved</div>
            }

            <!-- Wizard Scroll Container -->
            <div class="wizard-scroll">
                @Body
            </div>

            <!-- Wizard Bottom Bar -->
            <BottomActionBar
                OnPrev="PrevStep"
                OnNext="NextStep"
                DisablePrev="@Engine.IsFirstStep"
                DisableNext="@Engine.IsLastStep" />
        }
        else
        {
            <!-- Normal Page Scroll Container -->
            <div class="page-content">
                @Body
            </div>
        }

    </main>
</div>

<!-- MOBILE TOP BAR -->
<div class="menu-bar">
    <div class="menu-bar-inner">
        <span class="app-title">@(AppSettings.Settings?.TitleMobile ?? string.Empty)</span>
        @if ((AppSettings.Settings?.Id ?? string.Empty) != "Innermetrix-CIC")
        {
            <span class="css-version" aria-label="CSS version"></span>
        }
        <button class="navbar-toggler" @onclick="ToggleMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<!-- MOBILE OVERLAY MENU -->
<div class="menu-overlay @(isMenuOpen ? "open" : "")">
    <div class="menu-drawer">
        <NavMenu OnToggle="ToggleMenu" />
    </div>
</div>

@code {
    private bool isMenuOpen;
    private bool _showSavedMessage;

    protected override void OnInitialized()
    {
        Engine.ModelChanged += OnEngineChanged;
        AppSettings.SettingsChanged += OnSettingsChanged;
    }

    private void OnEngineChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnSettingsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Engine.ModelChanged -= OnEngineChanged;
        AppSettings.SettingsChanged -= OnSettingsChanged;
    }

    void ToggleMenu() => isMenuOpen = !isMenuOpen;

    string CurrentPageTitle =>
        Engine?.Definition?.Steps == null || Engine.Definition.Steps.Count == 0
            ? "Loading..."
            : Engine.CurrentStep?.Name ?? "Untitled";

    @* EventCallback CurrentSaveCallback =>
        Engine?.Definition?.Steps == null || Engine.Definition.Steps.Count == 0
            ? EventCallback.Empty
            : Engine.CurrentStep?.RequiresSaveButton == true
                ? EventCallback.Factory.Create(this, Save)
                : EventCallback.Empty;   *@

    bool RequiresSaveButton =>
        Engine?.Definition?.Steps == null || Engine.Definition.Steps.Count == 0
            ? false
            : Engine.CurrentStep?.RequiresSaveButton == true;

    private async Task Save()
    {
        await Engine.SaveModelAsync();

        _showSavedMessage = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(1000);

        _showSavedMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task NextStep()
    {
        Engine.NextStep();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PrevStep()
    {
        Engine.PreviousStep();
        await InvokeAsync(StateHasChanged);
    }

    private bool IsWizardPage =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/').ToLowerInvariant() is
            "site-geometry" or "ceo-value-time" or
            "structai-new-project" or "cic-sales-projection";
}
