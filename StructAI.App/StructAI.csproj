<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StructAI</AssemblyName>
    <RootNamespace>StructAI</RootNamespace>	
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.30" PrivateAssets="all" />
  </ItemGroup>

  <!-- <ItemGroup>
    <RazorComponent Include="Layout\**\*.razor" />
    <RazorComponent Include="Pages\**\*.razor" />
    <RazorComponent Include="Components\**\*.razor" />
  </ItemGroup> -->

  <ItemGroup>
    <RazorComponent Include="**\*.razor" />
  </ItemGroup>

<PropertyGroup>
  <EnableDefaultRazorCompileOnBuild>true</EnableDefaultRazorCompileOnBuild>
  <EnableDefaultRazorGenerate>true</EnableDefaultRazorGenerate>
  <!-- <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles> -->
</PropertyGroup>

</Project>
